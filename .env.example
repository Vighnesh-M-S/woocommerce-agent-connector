# WooCommerce site base URL (no trailing slash). Use https:// in production.
WC_BASE_URL=http://localhost:8080

# Generate these under WooCommerce -> Settings -> Advanced -> REST API.
# Permission level must be "Read" (this connector is read-only).
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here
